{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AllocationProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "plans"],
  "properties": {
    "mode": {"const": "propose"},
    "plans": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["plan_id", "allocations", "hold", "evidence_ids", "dependency_ids"],
        "properties": {
          "plan_id": {"type": "string", "minLength": 1},
          "allocations": {"type": "object", "minProperties": 1,
                          "additionalProperties": {"$ref": "#/$defs/decimal"}},
          "hold": {"$ref": "#/$defs/decimal"},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "dependency_ids": {"type": "array", "uniqueItems": true, "items": {"enum": [
            "budget", "withdrawal_immediate", "withdrawal_deadline",
            "withdrawal_notice", "risk_total", "risk_shared", "market_cash",
            "source_freshness"
          ]}}
        }
      }
    }
  },
  "$defs": {
    "decimal": {"type": "string", "maxLength": 100,
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
  }
}
