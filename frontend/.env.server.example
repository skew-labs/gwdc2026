# Copy to .env.server.local. Never prefix secrets with VITE_.
KILN_API_KEY=
APP_ORIGIN=http://127.0.0.1:5173
PORT=8000
DATABASE_PATH=.data/machine.sqlite
DAILY_MESSAGE_LIMIT=100
# Optional financial backend integration; no financial fixtures are bundled.
FINANCE_API_URL=
FINANCE_SERVICE_TOKEN=
# For production: NODE_ENV=production, APP_ORIGIN=https://your-domain.example
# Production message generation requires wallet ownership verification.
